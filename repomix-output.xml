        "    },\n",
        "}\n",
        "(OUT_EXP / \"run_meta.json\").write_text(\n",
        "    json.dumps(run_meta, indent=2, ensure_ascii=False, default=float), encoding=\"utf-8\"\n",
        ")\n",
        "print(\"run_meta.json đã ghi (môi trường + cấu hình + kết quả).\")\n",
        "\n",
        "_ran_txt = \", \".join(RAN)\n",
        "L = [\n",
        "    \"# Benchmark Tốc độ & Chất lượng — so sánh precision (fp32 / fp16 / fp8 / fp4)\",\n",
        "    \"\",\n",
        "    f\"- **Ngày:** {date.today().isoformat()}\",\n",
        "    f\"- **RUN_ID:** `{RUN_ID}`\",\n",
        "    f\"- **Thiết bị:** `{DEVICE_STR}` | torch {torch.__version__} | {platform.platform()}\",\n",
        "    f\"- **Dataset:** {DATASET_USED}\",\n",
        "    f\"- **Quy mô:** {len(JOBS)} ảnh × {PROMPTS_PER_IMAGE} prompt = {len(JOBS) * PROMPTS_PER_IMAGE} edit/config \"\n",
        "    f\"(warmup {WARMUP_EDITS} edit/config, không tính giờ)\",\n",
        "    f\"- **Ground truth:** `{REFERENCE}` (ảnh do bản gốc tạo ra)\",\n",
        "    f\"- **Config chạy được:** {_ran_txt}\",\n",
        "]\n",
        "if SKIPPED:\n",
        "    L.append(\"- **Config bị bỏ qua (GPU/lib không hỗ trợ):** \"\n",
        "             + \"; \".join(f\"`{n}` ({r})\" for n, r in SKIPPED.items()))\n",
        "L += [\n",
        "    \"\",\n",
        "    \"> **Lưu ý precision thấp (fp8/fp4):** đây là *weight-only quantization* (nén trọng số UNet). \"\n",
        "    \"Trên GPU Turing/T4 không có tensor core fp8/fp4 nên các mức này chủ yếu **giảm VRAM**, \"\n",
        "    \"thường **không tăng tốc** (có overhead giải nén). fp8/fp4 chỉ tăng tốc thật trên GPU mới (Ada/Hopper/Blackwell). \"\n",
        "    \"VAE luôn giữ fp32; chỉ Linear của UNet bị lượng tử hóa (Conv giữ nguyên).\",\n",
        "    \"\",\n",
        "    \"## 1. Tốc độ (wall-clock / edit)\",\n",
        "    \"\",\n",
        "    \"| Config | Mean (s) | Median (s) | Cache-miss (s) | Cache-hit (s) | Speedup (overall) | Speedup (cache-hit) |\",\n",
        "    \"|--------|---------:|-----------:|---------------:|--------------:|------------------:|--------------------:|\",\n",
        "]\n",
        "for c in RAN:\n",
        "    r = speed[c]\n",
        "    L.append(f\"| {c} | {fmt(r['mean'])} | {fmt(r['median'])} | {fmt(r['cache_miss_mean'])} | \"\n",
        "             f\"{fmt(r['cache_hit_mean'])} | {fmt(r['speedup_overall'])}× | {fmt(r['speedup_steady'])}× |\")\n",
        "\n",
        "# ---- Bảng VRAM (per-edit: max/min/mean) ----\n",
        "if has_vram:\n",
        "    L += [\"\", \"## 2. VRAM per-edit (bộ nhớ GPU, MB)\", \"\",\n",
        "          \"Đo peak VRAM cho **từng edit** (reset trước mỗi lần) rồi tổng hợp.\", \"\",\n",
        "          \"| Config | Max | Min | Mean | Model (nạp) | Giảm Max vs \" + REFERENCE + \" |\",\n",
        "          \"|--------|----:|----:|-----:|------------:|----:|\"]\n",
        "    for c in RAN:\n",
        "        r = vram[c]\n",
        "        saved = (1 - r[\"max\"] / base_vram_max) * 100 if base_vram_max and not np.isnan(r[\"max\"]) and not np.isnan(base_vram_max) else float(\"nan\")\n",
        "        L.append(f\"| {c} | {fmt(r['max'], 0)} | {fmt(r['min'], 0)} | {fmt(r['mean'], 0)} | \"\n",
        "                 f\"{fmt(r['model_mb'], 0)} | {fmt(saved, 1)}% |\")\n",
        "    L += [\"\", \"> **Max/Min/Mean** = thống kê peak VRAM qua các edit; **Model (nạp)** = VRAM sau khi \"\n",
        "          \"nạp trọng số (trước inference). fp16 lưu trọng số nửa kích thước nên giảm bộ nhớ. \"\n",
        "          \"CUDA dùng `max_memory_allocated` (chính xác, reset mỗi edit); \"\n",
        "          \"MPS dùng `driver_allocated_memory` (xấp xỉ, không reset được nên Min≈Max).\"]\n",
        "else:\n",
        "    L += [\"\", \"## 2. VRAM\", \"\", \"> Không đo được VRAM trên thiết bị này (CPU).\"]\n",
        "\n",
        "L += [\"\", \"## 3. Chất lượng so với ground truth (fp32)\", \"\",\n",
        "      \"Ảnh bản cải thiện được chấm so với ảnh bản gốc (cùng ảnh + cùng prompt).\", \"\"]\n",
        "head = \"| Config | PSNR↑ mean | PSNR min | SSIM↑ mean | SSIM min | \"\n",
        "sep = \"|--------|---:|---:|---:|---:|\"\n",
        "if has_lpips:\n",
        "    head += \"LPIPS↓ mean | LPIPS max | \"\n",
        "    sep += \"---:|---:|\"\n",
        "head += \"MSE↓ mean | N |\"\n",
        "sep += \"---:|---:|\"\n",
        "L += [head, sep]\n",
        "for c in OTHER:\n",
        "    r = qsummary[c]\n",
        "    row = f\"| {c} | {fmt(r['psnr_mean'])} | {fmt(r['psnr_min'])} | {fmt(r['ssim_mean'], 4)} | {fmt(r['ssim_min'], 4)} | \"\n",
        "    if has_lpips:\n",
        "        row += f\"{fmt(r['lpips_mean'], 4)} | {fmt(r['lpips_max'], 4)} | \"\n",
        "    row += f\"{fmt(r['mse_mean'], 5)} | {r['n']} |\"\n",
        "    L.append(row)\n",
        "\n",
        "L += [\n",
        "    \"\", \"## 4. Diễn giải\", \"\",\n",
        "    \"- **PSNR** (dB, ↑): > 30 dB ⇒ khác biệt rất nhỏ, mắt thường khó nhận ra; > 40 dB ⇒ gần như trùng.\",\n",
        "    \"- **SSIM** (0–1, ↑): > 0.95 ⇒ giữ gần như nguyên cấu trúc.\",\n",
        "    \"- **LPIPS** (↓): < 0.1 ⇒ rất giống về cảm nhận (perceptual).\",\n",
        "    \"- **MSE** (↓): càng nhỏ càng giống.\",\n",
        "    \"- **VRAM** (↓): precision thấp lưu trọng số nhỏ hơn ⇒ giảm bộ nhớ, chạy được trên GPU yếu / batch lớn hơn.\",\n",
        "]\n",
        "if \"improved_fp16_cache\" in RAN:\n",
        "    _f16 = \"improved_fp16_cache\"\n",
        "    _f16_psnr = qsummary.get(_f16, {}).get(\"psnr_mean\", float(\"nan\"))\n",
        "    L += [\"\",\n",
        "          f\"> **fp16 + cache:** nhanh **{fmt(speed[_f16]['speedup_overall'])}×** (overall) / \"\n",
        "          f\"**{fmt(speed[_f16]['speedup_steady'])}×** (cache-hit) vs fp32; PSNR **{fmt(_f16_psnr)} dB**. \"\n",
        "          \"Cache là **lossless** (tái dùng latent/embedding) nên khác biệt chất lượng (nếu có) đến từ precision, không phải cache.\"]\n",
        "\n",
        "# ================== Mục 5: Kết luận precision nào tốt nhất (tự động từ số liệu) ==================\n",
        "def _q(c, key):\n",
        "    return qsummary.get(c, {}).get(key, float(\"nan\"))\n",
        "\n",
        "\n",
        "def _vmax(c):\n",
        "    return vram.get(c, {}).get(\"max\", float(\"nan\")) if has_vram else float(\"nan\")\n",
        "\n",
        "\n",
        "L += [\"\", \"## 5. Kết luận: precision nào tốt nhất?\", \"\",\n",
        "      \"Đánh đổi tốc độ / VRAM / chất lượng (chất lượng chấm so với fp32 = ground truth). \"\n",
        "      \"fp8/fp4 là weight-only quant: trên T4 chủ yếu giảm VRAM, ít/không tăng tốc.\", \"\",\n",
        "      \"| Precision | Speedup overall | VRAM max (MB) | Giảm VRAM | PSNR↑ | SSIM↑ | LPIPS↓ | Ghi chú |\",\n",
        "      \"|-----------|----------------:|--------------:|----------:|------:|------:|-------:|---------|\"]\n",
        "for c in RAN:\n",
        "    sp = fmt(speed[c][\"speedup_overall\"]) + \"×\"\n",
        "    vm = _vmax(c)\n",
        "    vsav = (1 - vm / base_vram_max) * 100 if has_vram and base_vram_max and not np.isnan(vm) and not np.isnan(base_vram_max) else float(\"nan\")\n",
        "    if c == REFERENCE:\n",
        "        psnr = ssim = lpips = \"—\"\n",
        "        note = \"ground truth (chuẩn chất lượng, chậm + tốn VRAM nhất)\"\n",
        "    else:\n",
        "        pv = _q(c, \"psnr_mean\")\n",
        "        psnr = fmt(pv)\n",
        "        ssim = fmt(_q(c, \"ssim_mean\"), 4)\n",
        "        lpips = fmt(_q(c, \"lpips_mean\"), 4) if has_lpips else \"—\"\n",
        "        note = (\"—\" if np.isnan(pv) else\n",
        "                \"gần như trùng fp32\" if pv >= 40 else\n",
        "                \"khác biệt nhỏ\" if pv >= 30 else\n",
        "                \"có thể thấy khác biệt\")\n",
        "    L.append(f\"| {c} | {sp} | {fmt(vm, 0)} | {fmt(vsav, 1)}% | {psnr} | {ssim} | {lpips} | {note} |\")\n",
        "\n",
        "# Chọn tốt nhất theo từng tiêu chí + khuyến nghị cân bằng\n",
        "best_speed = max(RAN, key=lambda c: speed[c][\"speedup_overall\"]) if RAN else None\n",
        "_vram_ran = [c for c in RAN if not np.isnan(_vmax(c))]\n",
        "best_vram = min(_vram_ran, key=_vmax) if _vram_ran else None\n",
        "\n",
        "\n",
        "def _ok(c, thr):\n",
        "    pv = _q(c, \"psnr_mean\")\n",
        "    return (not np.isnan(pv)) and pv >= thr\n",
        "\n",
        "\n",
        "_good = [c for c in OTHER if _ok(c, 40)] or [c for c in OTHER if _ok(c, 30)] or OTHER\n",
        "recommended = max(_good, key=lambda c: speed[c][\"speedup_overall\"]) if _good else None\n",
        "\n",
        "L += [\"\", \"**Tốt nhất theo từng tiêu chí (tính từ số liệu lần chạy này):**\"]\n",
        "if best_speed:\n",
        "    L.append(f\"- **Nhanh nhất:** `{best_speed}` — {fmt(speed[best_speed]['speedup_overall'])}× vs fp32.\")\n",
        "if best_vram:\n",
        "    _bvm = _vmax(best_vram)\n",
        "    _bvs = (1 - _bvm / base_vram_max) * 100 if base_vram_max and not np.isnan(_bvm) and not np.isnan(base_vram_max) else float(\"nan\")\n",
        "    L.append(f\"- **Tiết kiệm VRAM nhất:** `{best_vram}` — max {fmt(_bvm, 0)}MB (giảm {fmt(_bvs, 1)}% vs fp32).\")\n",
        "L.append(\"- **Chất lượng cao nhất:** `baseline_fp32` (chính là ground truth) — đổi lại chậm và tốn VRAM nhất.\")\n",
        "if recommended:\n",
        "    L.append(\n",
        "        f\"- **Khuyến nghị tổng thể (cân bằng tốc độ × VRAM × chất lượng):** **`{recommended}`** — \"\n",
        "        f\"{fmt(speed[recommended]['speedup_overall'])}× vs fp32, \"\n",
        "        f\"PSNR {fmt(_q(recommended, 'psnr_mean'))} dB\"\n",
        "        + (f\", VRAM max {fmt(_vmax(recommended), 0)}MB\" if has_vram else \"\")\n",
        "        + \". Đây là precision nhanh nhất trong nhóm vẫn giữ chất lượng gần fp32.\"\n",
        "    )\n",
        "L += [\"\",\n",
        "      \"> **Đọc kết luận:** nếu ưu tiên **tốc độ thuần** trên T4 → fp16 thường thắng (fp8/fp4 không có tăng tốc phần cứng). \"\n",
        "      \"Nếu ưu tiên **chạy trên GPU bộ nhớ thấp / model lớn** → fp4 thắng về VRAM nhưng chất lượng giảm nhiều nhất. \"\n",
        "      \"fp32 chỉ nên dùng khi cần chất lượng tham chiếu tuyệt đối.\",\n",
        "      \"\"]\n",
        "L += [\n",
        "    \"## Tài liệu metric\",\n",
        "    \"- **PSNR/MSE:** chuẩn image fidelity.\",\n",
        "    \"- **SSIM:** Wang et al. 2004, *Image Quality Assessment: From Error Visibility to Structural Similarity*, IEEE TIP.\",\n",
        "    \"- **LPIPS:** Zhang et al. 2018, *The Unreasonable Effectiveness of Deep Features as a Perceptual Metric*, CVPR.\",\n",
        "    \"\",\n",
        "    \"## Tái lập\",\n",
        "    \"```bash\",\n",
        "    \"# Mac hoặc Colab: mở notebook và chạy tuần tự các cell\",\n",
        "    \"jupyter lab notebooks/CS2309_SwiftEdit_quality_speed_bench.ipynb\",\n",
        "    \"```\",\n",
        "    \"Chỉnh `N_IMAGES`, `PROMPTS_PER_IMAGE`, `EDIT_TEMPLATES`, `CONFIGS` ở cell cấu hình (③).\",\n",
        "    \"\",\n",
        "    \"## File trong thư mục\",\n",
        "    \"| File | Nội dung |\",\n",
        "    \"|------|----------|\",\n",
        "    \"| `report.md` | Báo cáo này |\",\n",
        "    \"| `run_meta.json` | Bằng chứng môi trường: GPU, version lib, git commit, cấu hình, kết quả tóm tắt |\",\n",
        "    \"| `timing_raw.csv` | Thời gian + VRAM từng edit (config/job/prompt/cache/vram_mb) |\",\n",
        "    \"| `quality_raw.csv` | PSNR/SSIM/LPIPS/MSE từng cặp ảnh |\",\n",
