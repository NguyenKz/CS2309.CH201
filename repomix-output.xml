from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SMOKE_DIR = ROOT / "data" / "PIE-Bench-smoke"
SWIFTEDIT = ROOT / "SwiftEdit"
DEMO = SWIFTEDIT / "assets" / "imgs_demo"

